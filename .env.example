# Administrador inicial. Solo se crea si la base todavía no tiene ninguno.
# La contraseña: 10 caracteres, mayúscula, minúscula, número y símbolo.
# Si incluye #, póngala entre comillas para que no se interprete como un comentario.
PORTAL_ADMIN_EMAIL=admin@fincasverco.es
PORTAL_ADMIN_NAME=Administración Fincas Verco
PORTAL_ADMIN_PASSWORD=""

# Origen público de los enlaces de activación y de restablecimiento.
APP_ORIGIN=http://localhost:8080

# Correo real (Resend). Sin clave, en local el mensaje se guarda en .data/outbox.
RESEND_API_KEY=
PORTAL_MAIL_FROM=Fincas Verco <noreply@fincasverco.es>
